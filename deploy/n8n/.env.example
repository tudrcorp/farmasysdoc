# Dominio de n8n (registro DNS tipo A apuntando al VPS), sin https://
N8N_DOMAIN=n8n.ejemplo.com

# Genere uno con:  openssl rand -hex 32   (guárdelo: sin él no se pueden leer las credenciales guardadas)
N8N_ENCRYPTION_KEY=

POSTGRES_USER=n8n
# Genere uno con:  openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=n8n
