<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <!-- TfhkaNet.dll exige proceso de 32 bits (CLR_32BITREQUIRED). -->
    <PlatformTarget>x86</PlatformTarget>
    <RootNamespace>Farmadoc.FiscalAgent.Service</RootNamespace>
    <AssemblyName>FarmadocFiscalAgent</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Farmadoc.FiscalAgent.Core\Farmadoc.FiscalAgent.Core.csproj" />
    <Reference Include="System.ServiceProcess" />
    <Reference Include="System.Configuration.Install" />
    <Reference Include="TfhkaNet">
      <HintPath>..\..\lib\TfhkaNet.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\agent.example.json" Link="agent.example.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
